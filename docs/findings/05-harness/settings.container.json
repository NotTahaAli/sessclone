{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "/work/post.sh SessionStart" }
        ]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "/work/post.sh Stop" }] }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "/work/post.sh SubagentStop" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "/work/post.sh SessionEnd" }]
      }
    ],
    "StopFailure": [
      {
        "hooks": [{ "type": "command", "command": "/work/post.sh StopFailure" }]
      }
    ]
  }
}
