# dependencies
node_modules/
.pnpm-store/

# builds
.next/
# Regenerated by `next dev` and `next build` in different forms, so a tracked
# copy is dirty after whichever one ran last. Its own header says not to edit
# it; nothing reads it but the type checker, which regenerates it.
next-env.d.ts
out/
dist/
build/
*.tsbuildinfo

# env and secrets
.env
.env.*
!.env.example

# local agent config and scratch
.claude/settings.local.json
.scratch/*/scratch/

# supabase local stack
supabase/.branches/
supabase/.temp/

# test and tooling output
coverage/
playwright-report/
test-results/
.eslintcache

# editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# archify visual-check evidence (regenerable)
docs/tickets/*.visual-check.*

# spike 05 harness output (regenerable, may carry session payloads)
docs/findings/05-harness/hooks.log

# deploy and test credentials
.vercel/
playwright/.auth/
*.pem

# Playwright (apps/web/e2e): the signed session and each run's output
apps/web/e2e/.auth/
apps/web/test-results/
