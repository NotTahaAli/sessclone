# sessclone — copy to apps/web/.env and fill in. See docs/configuration.md for
# what each variable is, which are required, and what the defaults mean.
#
# The destination is apps/web/.env and not a .env beside this file. Next.js
# reads environment files from its own project root, which is apps/web, so a
# .env at the repo root is loaded by nothing and the first page to need one
# fails with `NEXT_PUBLIC_SUPABASE_URL is not set`.
#
# Never commit .env. Every value below is a placeholder, not a credential.
#
# Most of these are not wired up yet: v1 is mid-build. The database and
# Supabase variables, NEXT_PUBLIC_APP_URL, and all four SESSCLONE_ variables
# are read by code today; storage is not. docs/configuration.md names the
# ticket for each of the rest.
#
# The Collector variables at the bottom belong on a member's own machine, in
# the shell Claude Code runs in, rather than in this file once it is a server's
# .env. They are listed here because this is the one place every variable is
# written down.

# --- Server: database ---------------------------------------------------
# Two connections, because they are deliberately two different roles. Both are
# required, with no default: the application throws rather than guessing, and
# there is no fallback from one to the other. The test harness supplies its own
# sessclone_test URLs.
#
# Everything the dashboard reads. Point this at `sessclone_app`, the role that
# owns nothing — created by supabase/migrations/20260920120200_app_role.sql.
# Postgres applies no policy at all to a superuser or to the role that owns the
# tables, so pointing this at the role that applied the migrations switches
# row-level security off for the whole application, with no error anywhere to
# say so: pages simply show every Org's rows.
DATABASE_URL=postgres://sessclone_app:sessclone_app@127.0.0.1:5432/sessclone
#
# What the ingest route writes as, and only that. This one *is* the migrating,
# owning role: `turns` and `log_artifacts` carry no insert policy by design
# (ADR 0001), and `sessclone_app` has no insert grant on either, so ingest
# answers `permission denied for table turns` if handed the variable above.
# Kept separate rather than reused so that a privileged connection has one
# named purpose instead of leaking into every page.
INGEST_DATABASE_URL=postgres://sessclone:sessclone@127.0.0.1:5432/sessclone

# --- Server: Supabase auth and browser client ---------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Bypasses every RLS policy. Server-side ingest paths only, never the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Server: public base URL --------------------------------------------
# The origin this deployment answers on. No trailing slash.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# --- Server: storage (any S3-compatible provider) -----------------------
STORAGE_ENDPOINT=https://your-account.r2.cloudflarestorage.com
STORAGE_BUCKET=sessclone-artifacts
STORAGE_ACCESS_KEY_ID=your-access-key-id
STORAGE_SECRET_ACCESS_KEY=your-secret-access-key
# Optional, shown with their defaults.
STORAGE_REGION=auto
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PRESIGN_TTL_SECONDS=300

# --- Pricing cache ------------------------------------------------------
# Shared secret for POST /api/pricing/revalidate, which clears the public
# pricing cache after a Tier is changed outside the admin panel. Unset means
# the route refuses every call; the panel's own save needs nothing here.
PRICING_REVALIDATE_SECRET=

# --- Collector: packages/plugin, on each member's machine ---------------
SESSCLONE_URL=http://127.0.0.1:3000
# Issued in the dashboard under Keys. The Collector refuses to start without
# one, and says so at session start rather than failing silently per report.
SESSCLONE_API_KEY=your-member-api-key
# Optional, and left commented on purpose: an empty assignment is set-but-empty,
# which defeats the platform default rather than selecting it.
# SESSCLONE_STATE_DIR=
# Only when one account runs several environments that should count as separate
# Devices. Left unset, the key is derived from the machine or the cloud account.
# SESSCLONE_DEVICE=
