{
  "openapi": "3.1.0",
  "info": {
    "title": "SessClone ingest",
    "version": "1",
    "description": "The endpoint the Collector reports Turns to. Self-hosted: the base URL is your own deployment."
  },
  "servers": [
    {
      "url": "/",
      "description": "This deployment"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "A Member API key, `sk_…`, created on the Keys page of the dashboard. It decides the Member and the Org every Turn is filed under; the payload names neither."
      }
    },
    "schemas": {
      "IngestPayload": {
        "type": "object",
        "properties": {
          "device": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "nickname": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "key"
            ]
          },
          "reports": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sessionId": {
                  "type": "string",
                  "minLength": 1
                },
                "agentId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "project": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "remote": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "key",
                    "remote"
                  ]
                },
                "cursor": {
                  "type": "object",
                  "properties": {
                    "messageId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "byteOffset": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "messageId",
                    "byteOffset"
                  ]
                },
                "turns": {
                  "maxItems": 5000,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "sessionId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "agentId": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "messageId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "model": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "serviceTier": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "speed": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "inferenceGeo": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "clientVersion": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "timestamp": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "date-time",
                            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "cwd": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "gitBranch": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "requestId": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "complete": {
                        "type": "boolean"
                      },
                      "spawnDepth": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "usage": {
                        "type": "object",
                        "properties": {
                          "inputTokens": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "outputTokens": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "cacheReadInputTokens": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "cacheCreationInputTokens": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "cacheCreation5mInputTokens": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "cacheCreation1hInputTokens": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "thinkingTokens": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "webSearchRequests": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "webFetchRequests": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "inputTokens",
                          "outputTokens",
                          "cacheReadInputTokens",
                          "cacheCreationInputTokens",
                          "cacheCreation5mInputTokens",
                          "cacheCreation1hInputTokens",
                          "thinkingTokens",
                          "webSearchRequests",
                          "webFetchRequests"
                        ]
                      },
                      "entryUuids": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "sessionId",
                      "agentId",
                      "messageId",
                      "model",
                      "serviceTier",
                      "speed",
                      "inferenceGeo",
                      "clientVersion",
                      "timestamp",
                      "cwd",
                      "gitBranch",
                      "requestId",
                      "complete",
                      "usage",
                      "entryUuids"
                    ]
                  }
                }
              },
              "required": [
                "sessionId",
                "agentId",
                "project",
                "cursor",
                "turns"
              ]
            }
          },
          "failures": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sessionId": {
                  "type": "string",
                  "minLength": 1
                },
                "agentId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "occurredAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                },
                "errorType": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "message": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 2000
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "sessionId",
                "occurredAt",
                "errorType"
              ]
            }
          },
          "sessionEnd": {
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "minLength": 1
              },
              "occurredAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            },
            "required": [
              "sessionId",
              "occurredAt"
            ]
          }
        },
        "required": [
          "device",
          "reports"
        ]
      },
      "IngestResponse": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sessionId": {
                  "type": "string"
                },
                "agentId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "turns": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "cursor": {
                  "type": "object",
                  "properties": {
                    "messageId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "byteOffset": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "messageId",
                    "byteOffset"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "sessionId",
                "agentId",
                "turns",
                "cursor"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "accepted"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/api/ingest": {
      "post": {
        "operationId": "ingest",
        "summary": "Report Turns",
        "description": "Reports what one or more transcripts grew by since their cursors. The key is checked before the body is read.\n\nIdempotent by conflict: re-sending a batch stores nothing twice, and is still acknowledged, so the Collector re-sends rather than skips when a response is lost.\n\nA batch carries at least one report, failure or session end. Every identifier must be non-blank.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted. One entry per report, echoing its cursor: advance to it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            }
          },
          "400": {
            "description": "Not an ingest payload (`detail` names the first problem and its path), or the database refused this batch. Nothing from the batch was written. Do not retry the same bytes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No live API key: missing, malformed, unknown and revoked keys all get this same answer. Stop and check the key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "const": "Bearer"
                }
              }
            }
          },
          "503": {
            "description": "The database is unavailable. Nothing from the batch was written; queue the batch and retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
